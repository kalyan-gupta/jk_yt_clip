# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Primary Bot Admin's Discord User ID (Enable Developer Mode in Discord, right-click avatar -> Copy User ID)
ADMIN_DISCORD_USER_ID=your_discord_user_id_here

# Enable or disable YouTube Live Chat reply (@User Clip recorded at HH:MM:SS) globally: true or false
ENABLE_CHAT_REPLY=true

# How many seconds before the !clip chat command to place the timestamp (industry standard is 30 seconds)
CLIP_OFFSET_SECONDS=30

# Cloud HTTP Health Check Port (Render, Railway, Fly.io, etc. will automatically inject this)
PORT=8080

# =========================================================================
# YouTube API Key Pool (Primary Keys + Reserve/OAuth Key)
# 1. Primary Chat Reading Keys: Used first for heavy chat polling
YOUTUBE_API_KEYS=project2_api_key,project3_api_key,project4_api_key

# 2. Reserve / OAuth Project Key (Optional safety net):
# Saved for last. Only used for reading if ALL primary keys run out of quota!
YOUTUBE_BACKUP_API_KEY=project1_oauth_api_key
# =========================================================================

# =========================================================================
# Cloud Deployment Secrets (Optional - Replaces JSON files on cloud hosts!)
# Supports single or MULTIPLE moderator OAuth accounts for chat replies:
# Option A: Single account
# YOUTUBE_OAUTH_TOKEN={"token": "...", "refresh_token": "...", ...}
#
# Option B: Multiple rotating moderator accounts (auto-rotates if one hits limit):
# YOUTUBE_OAUTH_TOKEN_1={"token": "...", "refresh_token": "...", ...}
# YOUTUBE_OAUTH_TOKEN_2={"token": "...", "refresh_token": "...", ...}
#
# Optional Client Secret:
# GOOGLE_CLIENT_SECRET={"installed": {"client_id": "...", ...}}
# =========================================================================
